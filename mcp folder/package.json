{
  "name": "ph-ereferral-mcp-server",
  "version": "1.0.0",
  "description": "MCP server that generates FHIR R4 referral bundles from clinical scenarios based on the PH eReferral Implementation Guide",
  "type": "module",
  "bin": {
    "ph-ereferral-mcp": "./build/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js"
  },
  "files": [
    "build"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.8.0"
  }
}
